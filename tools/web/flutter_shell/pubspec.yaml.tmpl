name: plate_embed_{{slug}}
description: Generated by tools/web/build_flutter.py. Do not edit.
publish_to: none
environment:
  sdk: ">=3.10.0 <4.0.0"
dependencies:
  flutter:
    sdk: flutter
  url_launcher: ^6.3.2
  web: ^1.1.1
  plate_core:
    path: {{root}}/plate_core
  plate_alphabet:
    path: {{root}}/plate_alphabet
  plate_keypad:
    path: {{root}}/plate_keypad
{{deps}}
dependency_overrides:
  plate_core:
    path: {{root}}/plate_core
  plate_alphabet:
    path: {{root}}/plate_alphabet
flutter:
  uses-material-design: true
  fonts:
    - family: Archivo
      fonts:
        - asset: assets/fonts/Archivo-latin.ttf
        - asset: assets/fonts/Archivo-latin-ext.ttf
    - family: MartianMono
      fonts:
        - asset: assets/fonts/MartianMono-latin.ttf
        - asset: assets/fonts/MartianMono-latin-ext.ttf
    - family: Vazirmatn
      fonts:
        - asset: assets/fonts/Vazirmatn-arabic.ttf
        - asset: assets/fonts/Vazirmatn-latin.ttf
        - asset: assets/fonts/Vazirmatn-latin-ext.ttf
